SECRET_KEY=replace-with-a-long-random-value
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost

DATABASE_NAME=avli_db
DATABASE_USER=avli
DATABASE_PASSWORD=replace-with-a-strong-password
DATABASE_HOST=db
